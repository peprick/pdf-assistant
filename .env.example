POSTGRES_DB=pdf_assistant
POSTGRES_USER=pdf_assistant
POSTGRES_PASSWORD=pdf_assistant
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=5173

APP_OLLAMA_BASE_URL=http://host.docker.internal:11434
APP_OLLAMA_CHAT_MODEL=qwen3:8b
APP_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
APP_RAG_EMBEDDING_DIMENSIONS=768

APP_OCR_ENABLED=true
APP_OCR_TESSERACT_COMMAND=tesseract
APP_OCR_LANGUAGE=eng
APP_OCR_DPI=300
APP_OCR_PAGE_SEGMENTATION_MODE=6
APP_OCR_MIN_TEXT_CHARACTERS_PER_PAGE=40
APP_OCR_TIMEOUT_SECONDS=60
